{
  "name": "Music PWA",
  "short_name": "Music",
  "description": "A modern, ad-free music streaming PWA",
  "start_url": "/",
  "display": "standalone",
  "background_color": "hsl(var(--background))",
  "theme_color": "hsl(var(--accent))",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}